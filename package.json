{
  "name": "passport-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm test",
    "test": "node --experimental-strip-types --test test/auth.test.mjs test/link-polling.test.mjs test/privacy.test.mjs test/link-location.test.mjs test/discord.test.mjs test/dates.test.mjs test/manual.test.mjs",
    "test:browser-session": "npm run build && node --test test/session-expiry.browser.mjs",
    "test:browser-link": "npm run build && node --test test/link-completion.browser.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser-consent": "npm run build && node --test test/consent-skin.browser.mjs",
    "test:browser-discord": "npm run build && node --test test/discord-connection.browser.mjs",
    "test:browser-membership": "npm run build && node --test test/membership-servers.browser.mjs",
    "test:browser-stats": "npm run build && node --test test/stats.browser.mjs",
    "test:browser-manual": "npm run build && node --test test/manual.browser.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
